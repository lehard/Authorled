{
  "name": "authorled-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/check-bundle.mjs",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b",
    "check:contrast": "node scripts/check-contrast.ts",
    "check:native-ui": "node scripts/check-native-ui.ts",
    "check:editor": "node scripts/check-editor.ts",
    "check:chat": "node scripts/check-chat.ts",
    "samples:export": "node scripts/samples.ts"
  },
  "dependencies": {
    "@ag-ui/client": "1.0.2",
    "@copilotkit/react-core": "1.79.1",
