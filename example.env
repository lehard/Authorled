# ---------------------------------------------------------------------------
# Required. Every model call goes through the LiteLLM proxy (agno/litellm/config.yaml).
# ---------------------------------------------------------------------------
# LiteLLM proxy admin key; used by the litellm service. Generate: openssl rand -hex 32
LITELLM_MASTER_KEY=***
# Key the API and Claude Engineer send to the proxy. The proxy has no key
# database, so set this to the LITELLM_MASTER_KEY value.
LITELLM_API_KEY=***
# DeepSeek API key; used only by the proxy (deepseek-fast, deepseek-thinking).
DEEPSEEK_API_KEY=***
# GigaChat authorization key and scope; used only by the proxy (gigachat-embeddings).
# GIGACHAT_SCOPE is GIGACHAT_API_PERS or GIGACHAT_API_B2B.
GIGACHAT_CREDENTIALS=***
GIGACHAT_SCOPE=GIGACHAT_API_PERS
# Sber500 gateway (OpenAI-compatible) address and key; used only by the proxy
# (giga-embeddings, bge-m3-embeddings, qwen3-embeddings).
SBER500_API_BASE=https://shared1.multitool.works:4000/v1
SBER500_API_KEY=***
# Active embedding model, a proxy alias: gigachat-embeddings, giga-embeddings,
# bge-m3-embeddings or qwen3-embeddings (all 1024 dimensions). Vectors of different
# models are incompatible: after changing it, recreate the shared_knowledge table
# and upload the documents again.
EMBEDDINGS_MODEL=giga-embeddings
# Password of the database role `agentos` the API connects with: not a superuser, owns schema
# `ai`, no access to schema `authentik` (agno/db/init.sql). Generate: openssl rand -hex 24
AGENTOS_DB_PASSWORD=***
# Proxy address for the API. Local Compose sets it to http://litellm:4000;
# set it here only when the API runs on the host (agno/docs/sandboxes.md).
# LITELLM_URL=http://127.0.0.1:4000

# ---------------------------------------------------------------------------
# Module auth: Authentik (identity provider, runs in compose) and JWT verification.
# Authorization is on in every environment; the API refuses to start without the
# keys, the issuer and the audience below.
# ---------------------------------------------------------------------------
# Authentik signs cookies and sessions with it. Generate: openssl rand -hex 32
AUTHENTIK_SECRET_KEY=***
# Password of the database role `authentik` (schema `authentik` in the shared database).
# Generate: openssl rand -hex 24
AUTHENTIK_DB_PASSWORD=***
# First administrator of Authentik (username akadmin), created on the first start only.
AUTHENTIK_BOOTSTRAP_EMAIL=admin@example.com
AUTHENTIK_BOOTSTRAP_PASSWORD=***
# Client ID of the Authentik application the frontends sign in with. It is also the
# audience (`aud`) the API requires in tokens.
AUTH_FRONTEND_CLIENT_ID=authorled-web
# Redirect URI of the frontend after sign-in.
AUTH_FRONTEND_REDIRECT_URI=http://localhost:5173/auth/callback
# App password of the development service account `sa-dev` (group plugins): the secret
# used to get tokens for curl and scripts. Generate: openssl rand -hex 24
AUTH_DEV_SERVICE_TOKEN=***
# Host name of Authentik as users open it (no port): Authentik applies the sign-in flow with
# the second factor to requests for this host. Locally localhost.
AUTH_BRAND_DOMAIN=localhost
# Issuer of the tokens, exactly as Authentik writes it: the address clients use to reach
# Authentik plus /application/o/authorled/. Locally http://localhost:9000/application/o/authorled/;
# a token requested via 127.0.0.1 has another issuer and is rejected.
AUTH_ISSUER=http://localhost:9000/application/o/authorled/
# Public keys of Authentik for token verification; the only key source the API accepts.
# Compose sets it for the API and writes the file at start (authentik-jwks-export). Set it here
# when the API runs on the host (scripts/dev.sh api does this for the API) and for
# `python -m evals`, which imports the application and stops without it.
# JWT_JWKS_FILE=/path/to/auth/jwks/jwks.json

# ---------------------------------------------------------------------------
# AgentOS URL used by the scheduler and MCP server.
# Set this to the public URL of your AgentOS instance.
# ---------------------------------------------------------------------------
# AGENTOS_URL=http://127.0.0.1:8000

# ---------------------------------------------------------------------------
# MCP OAuth — set MCP_CONNECT_SECRET to turn the /mcp endpoint into its own
# OAuth 2.1 authorization server, which is how claude.ai and ChatGPT (web) connect.
# Connecting to the MCP server asks for this secret on a consent page.
# Generate a strong one (≥16 chars):
#   openssl rand -base64 32
# ---------------------------------------------------------------------------
# MCP_CONNECT_SECRET=

# ---------------------------------------------------------------------------
# Web access uses Parallel SDK when authenticated,
# and falls back to Parallel's keyless MCP server for local development.
# ---------------------------------------------------------------------------
# PARALLEL_API_KEY=

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# DB_HOST=localhost
# DB_PORT=5432
# Compose and scripts/dev.sh set these for the API (DB_USER=agentos, DB_PASS from
# AGENTOS_DB_PASSWORD). In production DB_PASS is the bootstrap superuser password, used only by
# the init services and administration (compose.prod.yaml).
# DB_USER=agentos
# DB_PASS=
# DB_DATABASE=ai
# DB_DRIVER=postgresql+psycopg

# ---------------------------------------------------------------------------
# Optional AgentCore host access
# ---------------------------------------------------------------------------
# Select the sandbox provider, image and runtime ARN in agno/app/sandbox.py.
# AgentCore requires persistent /data storage on the API host; see agno/docs/sandboxes.md.
# Claude Engineer needs no Anthropic key: it calls the proxy with LITELLM_API_KEY.
# AWS_PROFILE=your-profile
# Alternatively use AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / AWS_SESSION_TOKEN
# on the host. AgentCore uses the region encoded in its runtime ARN.
# Host AWS credentials are not forwarded into the sandbox; use its execution role.
# Bedrock flags/region and private-repository GITHUB_READ_TOKEN must be supplied
# explicitly through the chosen provider's env mapping; see agno/docs/sandboxes.md.
