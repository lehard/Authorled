{
  "permissions": {
    "allow": [
      "Bash(./scripts/format.sh:*)",
      "Bash(./scripts/validate.sh:*)",
      "Bash(./agno/scripts/venv_setup.sh:*)",
      "Bash(./agno/scripts/generate_requirements.sh:*)",
      "Bash(source agno/.venv/bin/activate:*)",
      "Bash(python -m evals:*)",
      "Bash(docker compose up:*)",
      "Bash(docker compose restart:*)",
      "Bash(docker compose down:*)",
      "Bash(docker logs:*)",
      "Bash(docker inspect:*)",
      "Bash(curl -sSf http://localhost:8000/:*)",
      "Bash(curl -sS -X POST http://localhost:8000/:*)",
      "Bash(curl -s http://localhost:8000/:*)",
      "Bash(nc -z localhost:*)",
      "Bash(jq:*)",
      "WebFetch(domain:docs.agno.com)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/hook_session_start.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/hook_stop.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
