# Reverse proxy of the production server (openspec/specs/runtime, «Обратный прокси»).
# /etc/caddy/Caddyfile imports this file; deploy/deploy.sh reloads Caddy on each release.

# Flows of Authentik on the public hosts (openspec/specs/auth, «Потоки на публичных адресах»): only the
# flows of the product and the consent flow of its OIDC provider. Any other flow, the default flows of
# Authentik included, answers 404, so a superuser cannot sign in there past the refusal of the product
# flow. The first pattern catches every form of a flow path, the second lets through the exact ones.
(public_flows) {
	@foreign_flow {
		path_regexp (?i)/(if/flow|flows/executor)/
		not path_regexp ^/(if/flow|api/v3/flows/executor)/(authorled-authentication|authorled-enrollment|authorled-invalidation|default-provider-authorization-implicit-consent)/$
	}
	handle @foreign_flow {
		respond 404
	}
}

app.soavtor.app {
	import public_flows

	# AgentOS: the frontend reaches it on its own origin under /os/.
	handle_path /os/* {
		reverse_proxy 127.0.0.1:8000
	}

	# The sign-in API of Authentik on the frontend's origin (openspec/specs/auth, «Вход фронтенда»).
	# Authentik chooses the brand by host, so it gets its own host, as with the proxy of the dev server.
	@authentik path /api/v3/flows/executor/* /flows/-/cancel/* /application/o/revoke/*
	handle @authentik {
		reverse_proxy 127.0.0.1:9000 {
			header_up Host auth.soavtor.app
		}
	}

	# The frontend of the current release; addresses of screens open index.html.
	handle {
		# Only here: encode appends -gzip to ETag, and the API sends the revision in ETag.
		encode gzip
		# The page manifest has its own type (openspec/specs/runtime, «Тип манифеста страниц»): Go takes types
		# from /usr/share/mime/globs2 of the server, which has no .webmanifest. The deferred header wins.
		@manifest path *.webmanifest
		header @manifest >Content-Type application/manifest+json
		root * /srv/authorled/web/current
		try_files {path} /index.html
		file_server
	}
}

# Authentik for the users: sign-in, consent, profile. The admin interface is only on admin.soavtor.app.
auth.soavtor.app {
	import public_flows

	@admin path /if/admin /if/admin/*
	handle @admin {
		respond 404
	}

	handle {
		reverse_proxy 127.0.0.1:9000
	}
}

# The admin interface of Authentik (openspec/specs/auth, «Интерфейс Authentik»; openspec/specs/runtime,
# «Обратный прокси»): a TLS connection only with a client certificate signed by the owner's CA
# (scripts/admin_cert.sh makes both). Without the file of the CA the configuration does not load.
# With client_auth Caddy turns strict_sni_host on, so a Host of this site over another TLS name is
# refused; deploy/check_admin.sh checks it after each release.
admin.soavtor.app {
	tls {
		client_auth {
			mode require_and_verify
			trust_pool file /etc/authorled/admin-client-ca.pem
		}
	}

	reverse_proxy 127.0.0.1:9000
}

# The product site (openspec/specs/web/site): static files of the current release. Of the API only
# the beta request route is reachable here; other /os/ paths get the 404 page of the site.
soavtor.app {
	handle /os/api/v1/beta-requests {
		uri strip_prefix /os
		reverse_proxy 127.0.0.1:8000
	}

	handle {
		encode gzip
		# The page manifest has its own type (openspec/specs/runtime, «Тип манифеста страниц»): Go takes types
		# from /usr/share/mime/globs2 of the server, which has no .webmanifest. The deferred header wins.
		@manifest path *.webmanifest
		header @manifest >Content-Type application/manifest+json
		root * /srv/authorled/site/current
		file_server
	}

	handle_errors 404 {
		root * /srv/authorled/site/current
		rewrite * /404.html
		file_server
	}
}

www.soavtor.app {
	redir https://soavtor.app{uri} permanent
}

# The old address of the service: links and bookmarks keep working.
coauthor.glavai.ru {
	redir https://app.soavtor.app{uri} permanent
}
